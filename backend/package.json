{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npx prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.js --forceExit --detectOpenHandles",
    "lint": "eslint src/",
    "postinstall": "npx prisma generate",
    "seed:demo": "tsx prisma/seed.ts",
    "events:backfill": "tsx src/scripts/backfillEvents.ts",
    "seed:anon": "tsx prisma/seed.anonymized.ts",
    "mutation": "stryker run stryker.money-math.config.json",
    "mutation:ci": "stryker run stryker.money-math.config.json --reporters html,json,progress",
    "spec:package": "node scripts/package-openapi.js",
    "codegen:client": "npm run spec:package && openapi-typescript dist/openapi.json -o ../frontend/src/lib/generated/api.ts && openapi-typescript dist/openapi.json -o ../mobile/src/api/generated/api.ts",
    "codegen:check": "npm run codegen:client && git diff --exit-code -- ../frontend/src/lib/generated/api.ts ../mobile/src/api/generated/api.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Amana backend service",
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/exporter-jaeger": "2.12.0",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-zipkin": "2.12.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@pinata/sdk": "2.1.0",
    "@prisma/client": "7.10.0",
    "@stellar/stellar-sdk": "17.2.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/helmet": "4.0.0",
    "axios": "1.20.0",
    "bullmq": "6.3.15",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "sharp": "0.35.5",
    "swagger-ui-express": "5.0.1",
    "yamljs": "0.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@pact-foundation/pact": "17.1.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/json2csv": "5.0.7",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "openapi-typescript": "7.13.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/jest-runner": "8.7.1",
    "@stryker-mutator/typescript-checker": "8.7.1"
  }
}
